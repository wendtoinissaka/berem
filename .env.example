# ========================================
# APPLICATION
# ========================================
NEXT_PUBLIC_SITE_URL=https://berem.bf
NEXT_PUBLIC_WHATSAPP_NUMBER=226XXXXXXXX

# ========================================
# MYSQL
# ========================================
MYSQL_DATABASE=berem
MYSQL_USER=berem
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

# Connexion utilisée lorsque Next.js tourne directement sur la machine hôte.
DATABASE_URL="mysql://berem:CHANGE_ME@localhost:3307/berem"

# Port local de l'application Docker
APP_PORT=3000

# ========================================
# EMAIL - SMTP
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ADMIN_EMAIL=your-email@gmail.com

# ========================================
# AUTHENTIFICATION
# ========================================
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET

# ========================================
# API
# ========================================
KEY_NAME=berem
API_KEY=REPLACE_WITH_API_KEY
API_SECRET=REPLACE_WITH_API_SECRET

# ========================================
# CLOUDINARY
# ========================================
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME