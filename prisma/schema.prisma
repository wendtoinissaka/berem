generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum MediaType {
  IMAGE
  VIDEO
}

enum QuoteStatus {
  NEW
  IN_REVIEW
  ADDITIONAL_INFO_REQUIRED
  QUOTE_SENT
  CLOSED
}

enum SolutionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectType {
  BUILDING
  ROAD
  SANITATION
  ENGINEERING_STRUCTURE
  OTHER
}

enum ProjectStageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}


model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  description     String        @db.Text
  location        String
  type            ProjectType   @default(OTHER)
  status          ProjectStatus @default(PLANNED)
  progress        Int           @default(0)
  startDate       DateTime?
  expectedEndDate DateTime?
  completedAt     DateTime?
  isPublished     Boolean       @default(false)
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  media   ProjectMedia[]
  stages  ProjectStage[]
  updates ProjectUpdate[]

  @@index([status, isPublished])
  @@index([type, status])
  @@index([archivedAt])
}


model ProjectMedia {
  id        String    @id @default(cuid())
  projectId String
  url       String
  publicId  String?
  type      MediaType
  caption   String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}


model ProjectStage {
  id          String             @id @default(cuid())
  projectId   String
  name        String
  description String?            @db.Text
  status      ProjectStageStatus @default(NOT_STARTED)
  sortOrder   Int                @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updates ProjectUpdate[]

  @@index([projectId, sortOrder])
  @@index([projectId, status])
}

model ProjectUpdate {
  id          String    @id @default(cuid())
  projectId   String
  stageId     String?
  title       String
  description String    @db.Text
  progress    Int
  eventDate   DateTime  @default(now())
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  isPublished Boolean   @default(false)

  project Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage   ProjectStage?        @relation(fields: [stageId], references: [id], onDelete: SetNull)
  media   ProjectUpdateMedia[]

  @@index([projectId, eventDate])
  @@index([projectId, isPublished, eventDate])
  @@index([stageId])
}

model ProjectUpdateMedia {
  id              String    @id @default(cuid())
  projectUpdateId String
  url             String
  publicId        String?
  type            MediaType
  caption         String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())

  projectUpdate ProjectUpdate @relation(fields: [projectUpdateId], references: [id], onDelete: Cascade)

  @@index([projectUpdateId, sortOrder])
}

model QuoteRequest {
  id              String      @id @default(cuid())
  fullName        String
  company         String?
  email           String
  phone           String
  projectType     String
  location        String
  description     String      @db.Text
  estimatedBudget String?
  desiredDate     DateTime?
  status          QuoteStatus @default(NEW)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  activities QuoteActivity[]

  @@index([status, createdAt])
}

model Testimonial {
  id          String   @id @default(cuid())
  clientName  String
  company     String?
  role        String?
  content     String   @db.Text
  projectName String?
  photoUrl    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model QuoteActivity {
  id             String       @id @default(cuid())
  quoteRequestId String
  type           String
  message        String       @db.Text
  oldStatus      QuoteStatus?
  newStatus      QuoteStatus?
  createdAt      DateTime     @default(now())

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId, createdAt])
}


model Solution {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  summary          String
  description      String         @db.Text

  logoUrl          String?
  logoPublicId     String?
  coverImageUrl    String?
  coverPublicId    String?

  websiteUrl       String?
  actionLabel      String?        @default("Découvrir la solution")

  status           SolutionStatus @default(DRAFT)
  isFeatured       Boolean        @default(false)
  sortOrder        Int            @default(0)
  publishedAt      DateTime?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  features         SolutionFeature[]
  media            SolutionMedia[]

  @@index([status, sortOrder])
  @@index([isFeatured, status])
}



model SolutionFeature {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  sortOrder   Int      @default(0)

  solutionId  String
  solution    Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@index([solutionId, sortOrder])
}

model SolutionMedia {
  id          String    @id @default(cuid())
  url         String
  publicId    String?
  type        MediaType @default(IMAGE)
  caption     String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  solutionId  String
  solution    Solution  @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@index([solutionId, sortOrder])
}

enum StatisticSource {
  MANUAL
  COMPLETED_PROJECTS
  ONGOING_PROJECTS
  ACTIVE_SERVICES
  PUBLISHED_SOLUTIONS
  PUBLISHED_TESTIMONIALS
}

model HomeStatistic {
  id          String           @id @default(cuid())
  label       String
  description String?
  source      StatisticSource  @default(MANUAL)
  manualValue String?
  suffix      String?
  isVisible   Boolean          @default(true)
  sortOrder   Int              @default(0)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isVisible, sortOrder])
}