generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum MediaType {
  IMAGE
  VIDEO
}

enum QuoteStatus {
  NEW
  IN_REVIEW
  ADDITIONAL_INFO_REQUIRED
  QUOTE_SENT
  CLOSED
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  description     String        @db.Text
  location        String
  status          ProjectStatus @default(PLANNED)
  progress        Int           @default(0)
  startDate       DateTime?
  expectedEndDate DateTime?
  completedAt     DateTime?
  isPublished     Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  media   ProjectMedia[]
  updates ProjectUpdate[]

  @@index([status, isPublished])
}

model ProjectMedia {
  id        String    @id @default(cuid())
  projectId String
  url       String
  type      MediaType
  caption   String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectUpdate {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String   @db.Text
  progress    Int
  publishedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, publishedAt])
}

model QuoteRequest {
  id              String      @id @default(cuid())
  fullName        String
  company         String?
  email           String
  phone           String
  projectType     String
  location        String
  description     String      @db.Text
  estimatedBudget String?
  desiredDate     DateTime?
  status          QuoteStatus @default(NEW)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, createdAt])
}

model Testimonial {
  id          String   @id @default(cuid())
  clientName  String
  company     String?
  role        String?
  content     String   @db.Text
  projectName String?
  photoUrl    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
}
