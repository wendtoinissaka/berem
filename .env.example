
# ========================================
# APPLICATION
# ========================================
NEXT_PUBLIC_SITE_URL=https://berem.bf
NEXT_PUBLIC_WHATSAPP_NUMBER=226XXXXXXXX
SITE_URL=https://berem.bf
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ========================================
# MYSQL
# ========================================
MYSQL_DATABASE=berem
MYSQL_USER=berem
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

# Connexion interne Docker
DATABASE_URL=mysql://berem:CHANGE_ME@db:3306/berem

# ========================================
# EMAIL - SMTP
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ADMIN_EMAIL=your-email@gmail.com

# ========================================
# AUTHENTIFICATION
# ========================================
ADMIN_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_32_CHARS_MINIMUM

# ========================================
# API
# ========================================
KEY_NAME=berem
API_KEY=REPLACE_WITH_API_KEY
API_SECRET=REPLACE_WITH_API_SECRET

# ========================================
# CLOUDINARY
# ========================================
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
